# direnv용 설정 속성. 복사해서 .envrc로 저장하고 값을 채운 뒤 direnv allow를 실행한다.
# .envrc는 비밀 값을 담으므로 커밋하지 않는다.

# 운영 DB(Neon) 연결 URL. 비밀번호는 넣지 않고 DB_PWD로 따로 둔다.
# make migrate, make batch, make status, make web-prod와 배포 스크립트가 이 값을 쓴다.
# 로컬 개발 명령(make web, make test-integration, make db-*)은 compose.yaml의 로컬 DB를 쓰므로 여기를 바꾸지 않는다.
export DB_URL="postgres://<role>@<neon-host>/<database>?sslmode=require"
export DB_PWD=""

# Claude API 키(로컬 개발용). ANTHROPIC_API_KEY라는 이름을 쓰지 않는 것은
# 같은 디렉터리에서 실행한 Claude Code 같은 도구가 이 키를 자동으로 가져다 쓰지 않게 하기 위해서다.
export CLAUDE_API_KEY=""

# 로그인(선택). GOOGLE_CLIENT_ID가 없으면 로그인을 쓰지 않는다.
# 로컬에서 쓰려면 Google OAuth 클라이언트의 승인된 리디렉션 URI에 http://localhost:8080/auth/callback을 더한다.
# SESSION_SECRET과 USER_ID_SECRET은 32바이트 이상의 임의의 값이다(예: openssl rand -base64 48).
# USER_ID_SECRET은 Google 계정 고유 번호를 HMAC-SHA256할 때 쓰는 키다. 없으면 관리자 로그인만 쓰고 북마크는 쓰지 않는다.
# 바꾸면 모든 사용자가 새 사용자가 되어 북마크를 잃으므로 한 번 정하면 바꾸지 않는다.
# export GOOGLE_CLIENT_ID=""
# export GOOGLE_CLIENT_SECRET=""
# export SESSION_SECRET=""
# export USER_ID_SECRET=""
# export SITE_URL="http://localhost:8080"

# 대화방 주간 요약(batch weekly). 카카오톡 대화방 메시지를 모은 Google 스프레드시트의 Apps Script 웹 앱 주소(…/exec)와 토큰.
# 시트와 웹 앱은 kakao-to-google-sheet 저장소에서 만든다. 요약은 BAND_STATE_PATH의 밴드 세션으로 밴드에 올린다.
# export KAKAO_SHEET_URL=""
# export KAKAO_SHEET_TOKEN=""

# 선택 속성(기본값이 있음)
# export BAND_NO="102765569"
# export BAND_STATE_PATH="band-state.json"
# export PORT="8080"
# export KAKAO_ROOM="ABC(아카라카북클럽)"
